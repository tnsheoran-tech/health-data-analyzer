flowchart TB
    A[("Raw dataset<br/>CSV / JSON")] --> B["data_loader<br/>read + schema check"]
    G["data_generator<br/>seeded simulation"] -.creates.-> A
    B --> C["preprocessing<br/>types, categories, ranges,<br/>duplicates, imputation"]
    C --> D["analysis<br/>mean, median, SD, min/max,<br/>frequencies, correlations"]
    C --> P[("Processed CSV")]
    D --> T[("Tables CSV")]
    C --> V["visualization<br/>6 Matplotlib charts"]
    V --> F[("PNG figures")]
    D --> R["report<br/>Markdown summary"]
    C --> R
    F --> R
    R --> O[("summary_report.md")]
    CFG["config<br/>schema, ranges, mappings"] -.used by.-> B
    CFG -.-> C
    PL["pipeline.py + main.py<br/>orchestrator / CLI"] -.controls.-> B
    classDef store fill:#eef4fc,stroke:#2a78d6;
    class A,P,T,F,O store;
